# Port the Express server binds to.
PORT=4000

# Comma-separated list of origins allowed to call /api/*.
# Requests from any other Origin are rejected by CORS.
# Example (prod): FRONTEND_ORIGIN=https://rigready.example.com,https://www.rigready.example.com
FRONTEND_ORIGIN=http://localhost:5173

# Set to "production" in deployed environments. Disables verbose error
# detail in HTTP responses.
NODE_ENV=development

# Optional. Legacy RAWG integration — currently unused (data source swapped
# to the Steam Store public API). Leave blank unless you re-enable RAWG.
# Get a free key at https://rapidapi.com/accujazz/api/rawg-video-games-database
RAPIDAPI_KEY=
